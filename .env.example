# 오피넷 (한국석유공사) — 주유소 실시간 가격
OPINET_API_KEY=

# 카카오
KAKAO_REST_API_KEY=          # 주소→좌표 지오코딩 (백엔드)
NEXT_PUBLIC_KAKAO_MAP_KEY=   # 카카오맵 JS SDK (프론트)

# Claude API (대화 에이전트 / 실효비용 계산)
ANTHROPIC_API_KEY=

# DB (세션/대화 이력 저장, 선택)
DATABASE_URL=sqlite:///./oilradar.db

# 1단계 콘솔 데모 기본 좌표 (대전 둔산동, 미지정 시 사용)
DEFAULT_LAT=36.3504
DEFAULT_LNG=127.3845
